class Solution:
    def sortedSquares(self, nums: List[int]) -> List[int]:
        n = len(nums)
        result = [0] * n
        left = 0 
        right = n - 1
        pos = n - 1

        while left <= right:
            left_sq = nums[left] ** 2
            right_sq = nums[right] ** 2
            
            # Compare the squared values, not the pointers themselves
            if left_sq > right_sq:
                result[pos] = left_sq
                left += 1  # Move left pointer inward
            else: 
                result[pos] = right_sq
                right -= 1 # Move right pointer inward
                
            pos -= 1
            
        return result
